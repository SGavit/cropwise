APP_ID=cropwise
JWT_SECRET=replace-with-a-random-32-plus-character-secret
DATABASE_URL=mysql://user:password@host:3306/cropwise
OWNER_OPEN_ID=email:you@example.com

# OpenAI-compatible provider
#AI_API_URL=https://api.openai.com
#AI_API_KEY=
#AI_MODEL=gpt-4o-mini
#AI_IMAGE_MODEL=gpt-image-1

# Gemini
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
