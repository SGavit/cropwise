# Optional Google Maps
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Storage: local works for online testing; use s3 for production
STORAGE_MODE=local
LOCAL_STORAGE_DIR=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Optional password reset email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
